    <dimen name="keyboard_top_spacing">4dp</dimen>
    <dimen name="keyboard_side_padding">8dp</dimen>
    <dimen name="keyboard_bottom_spacing">2dp</dimen>
    <dimen name="button_hints_height">16dp</dimen>
    <dimen name="button_hints_font_size">11sp</dimen>
