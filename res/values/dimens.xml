<resources>

    <!-- andr36oid: sized for 640x480 and 720x720 consoles at 178-200 dpi (575 dp wide) in
         values-w520dp. These are for narrow screens like 480x640 portrait (431 dp wide).
         About 190 dp tall with suggestions, so the text field stays visible above. -->

    <dimen name="recognizer_size">96dp</dimen>
    <dimen name="selector_size">24dp</dimen>
    <dimen name="action_button_size">64dp</dimen>
    <dimen name="mode_change_key_font_size">7sp</dimen>
    <dimen name="resize_move_distance">12dp</dimen>

    <!-- Keys: the space key is 7 keys and 6 gaps wide. -->
    <dimen name="key_width">27dp</dimen>
    <dimen name="key_height">25dp</dimen>
    <dimen name="keyboard_horizontal_gap">5dp</dimen>
    <dimen name="keyboard_vertical_gap">5dp</dimen>
    <dimen name="space_key_width">219dp</dimen>
    <dimen name="key_corner_radius">6dp</dimen>
    <dimen name="key_font_size">17sp</dimen>
    <dimen name="function_key_mode_change_font_size">12sp</dimen>

    <!-- Action key (Done, Next, Search, the app's own label) right of the keys -->
    <dimen name="action_key_width">60dp</dimen>
    <dimen name="action_key_margin">6dp</dimen>
    <dimen name="enter_key_height">55dp</dimen>
    <dimen name="enter_key_font_size">15sp</dimen>
    <dimen name="enter_key_padding_horizontal">6dp</dimen>

    <!-- Focus ring around the focused key, like the setup wizard's buttons: 2dp outside it -->
    <dimen name="focus_ring_outset">2dp</dimen>

    <!-- Suggestions line above, button hints below -->
    <dimen name="candidate_font_size">15sp</dimen>
    <dimen name="candidate_padding_horizontal">10dp</dimen>
    <dimen name="candidate_margin_horizontal">2dp</dimen>
    <dimen name="candidate_height">24dp</dimen>
    <dimen name="candidate_scroll_view_horz_spacing">8dp</dimen>
    <dimen name="keyboard_top_spacing">4dp</dimen>
    <dimen name="keyboard_side_padding">3dp</dimen>
    <dimen name="keyboard_bottom_spacing">2dp</dimen>
    <dimen name="button_hints_height">16dp</dimen>
    <dimen name="button_hints_font_size">11sp</dimen>

</resources>
